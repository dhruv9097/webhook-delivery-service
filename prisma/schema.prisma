// Relay data model.
//
// The central decision here is that Event and Delivery are separate tables.
// One event fans out to N subscribed endpoints, producing N delivery rows that
// retry independently on their own schedules. That separation is the failure
// isolation boundary: a customer whose endpoint is down accumulates retries on
// their own delivery rows and cannot affect anyone else's.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users        User[]
  apiKeys      ApiKey[]
  applications Application[]

  @@map("organizations")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(MEMBER)
  mfaSecret    String?  @map("mfa_secret")
  createdAt    DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("users")
}

// API keys are never stored in plaintext. We keep sha256(key) plus a short
// non-secret prefix (rly_live_ab12cd) so the dashboard can identify a key in a
// list and so leaked keys are greppable by secret scanners.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  name       String
  prefix     String    @unique
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

enum Environment {
  TEST
  LIVE
}

// An application scopes events and endpoints, so a tenant can run a TEST and a
// LIVE environment side by side without their traffic mixing.
model Application {
  id          String      @id @default(cuid())
  orgId       String      @map("org_id")
  name        String
  environment Environment @default(TEST)
  createdAt   DateTime    @default(now()) @map("created_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoints Endpoint[]
  events    Event[]

  @@unique([orgId, name, environment])
  @@index([orgId])
  @@map("applications")
}

enum EndpointState {
  ENABLED
  DISABLED
}

// Note what is NOT here: circuit breaker state. That lives in Redis because it
// is ephemeral, high-churn, and safe to lose — a cold start simply re-learns
// that an endpoint is failing. `state = DISABLED` is the durable decision made
// after sustained failure, and it survives a Redis flush.
model Endpoint {
  id              String        @id @default(cuid())
  appId           String        @map("app_id")
  url             String
  description     String?
  // Empty array means "subscribe to everything".
  eventTypes      String[]      @map("event_types")
  secretCurrent   String        @map("secret_current")
  // Retained for a window after rotation so both signatures verify and the
  // customer can roll their verifier without dropping events.
  secretPrevious  String?       @map("secret_previous")
  secretRotatedAt DateTime?     @map("secret_rotated_at")
  state           EndpointState @default(ENABLED)
  disabledAt      DateTime?     @map("disabled_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  app        Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([appId])
  @@map("endpoints")
}

model Event {
  id             String   @id @default(cuid())
  appId          String   @map("app_id")
  eventType      String   @map("event_type")
  payload        Json
  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  app        Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  // Postgres treats NULLs as distinct in a unique index, so this gives exactly
  // the semantics we want for free: at most one event per (app, key), while
  // unlimited events may omit the key entirely. No partial index needed.
  @@unique([appId, idempotencyKey])
  @@index([appId, createdAt(sort: Desc)])
  @@map("events")
}

enum DeliveryState {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  RETRYING
  FAILED_PERMANENT
  DISCARDED
}

// lockedUntil is the crash-recovery mechanism. A worker claims a row by setting
// state=IN_FLIGHT and a lease expiry; if that worker dies, the reaper finds the
// expired lease and returns the row to RETRYING. This is what makes "kill -9 a
// worker mid-delivery" a non-event.
model Delivery {
  id            String        @id @default(cuid())
  eventId       String        @map("event_id")
  endpointId    String        @map("endpoint_id")
  state         DeliveryState @default(PENDING)
  attemptCount  Int           @default(0) @map("attempt_count")
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?     @map("locked_until")
  lockedBy      String?       @map("locked_by")
  lastError     String?       @map("last_error")
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts DeliveryAttempt[]

  // Fan-out must be idempotent: replaying the same event cannot create a second
  // delivery to the same endpoint.
  @@unique([eventId, endpointId])
  @@index([endpointId, createdAt(sort: Desc)])
  // The worker's claim query needs a partial index on
  // (next_attempt_at) WHERE state IN ('PENDING','RETRYING'). Prisma cannot
  // express partial indexes, so it is added by hand in the migration —
  // see prisma/migrations/*/migration.sql.
  @@map("deliveries")
}

model DeliveryAttempt {
  id                  String   @id @default(cuid())
  deliveryId          String   @map("delivery_id")
  attemptNo           Int      @map("attempt_no")
  requestHeaders      Json?    @map("request_headers")
  responseStatus      Int?     @map("response_status")
  responseBodySnippet String?  @map("response_body_snippet")
  latencyMs           Int?     @map("latency_ms")
  errorKind           String?  @map("error_kind")
  attemptedAt         DateTime @default(now()) @map("attempted_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNo])
  @@index([deliveryId])
  @@map("delivery_attempts")
}
